generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int           @id @default(autoincrement())
  username     String        @unique
  password     String
  name         String
  role         String
  ip_address   String?
  location     String?
  last_seen    DateTime?
  logs         AuditLog[]
  jobs         Job[]
  transactions Transaction[]
}

model RolePermission {
  role        String @id
  permissions Json
}

model Customer {
  cv           String  @id
  name         String
  phone        String?
  address      String?
  sub_district String?
  district     String?
  province     String?
  zipcode      String?
  latitude     Float?
  longitude    Float?
  image_url    String?
  jobs         Job[]
}

model Warehouse {
  id           Int              @id @default(autoincrement())
  name         String           @unique
  is_active    Boolean          @default(true)
  latitude     Float?
  longitude    Float?
  jobs         Job[]
  target_txns  Transaction[]    @relation("TargetWarehouse")
  transactions Transaction[]
  stocks       WarehouseStock[]
}

model WarehouseStock {
  id             Int        @id @default(autoincrement())
  item_id        Int
  warehouse_id   Int
  stock_qty      Int        @default(0)
  repair_qty     Int        @default(0)
  scrap_qty      Int        @default(0)
  lost_qty       Int        @default(0)
  quarantine_qty Int        @default(0)
  transit_qty    Int        @default(0)
  item           MasterItem @relation(fields: [item_id], references: [id])
  warehouse      Warehouse  @relation(fields: [warehouse_id], references: [id])

  @@unique([item_id, warehouse_id])
}

model Zone {
  name         String        @id
  details      String?
  transactions Transaction[]
}

model MasterItem {
  id               Int              @id @default(autoincrement())
  category         String
  brand            String?
  item_name        String?
  condition        String?
  details          String?
  size             String?
  stock_qty        Int              @default(0)
  repair_qty       Int              @default(0)
  lost_qty         Int              @default(0)
  scrap_qty        Int              @default(0)
  quarantine_qty   Int              @default(0)
  transit_qty      Int              @default(0)
  transactions     Transaction[]
  warehouse_stocks WarehouseStock[]
}

model Job {
  job_id            String        @id
  customer_cv       String?
  job_type          String
  operator_id       Int
  status            String
  note              String?
  created_at        DateTime      @default(now())
  delivery_by       String?
  notification_date DateTime?
  notifier          String?
  appointment_date  DateTime?
  warehouse_id      Int?
  customer          Customer?     @relation(fields: [customer_cv], references: [cv])
  operator          User          @relation(fields: [operator_id], references: [id])
  warehouse         Warehouse?    @relation(fields: [warehouse_id], references: [id])
  transactions      Transaction[]
}

model Transaction {
  id               Int         @id @default(autoincrement())
  job_id           String?
  item_id          Int?
  operator_id      Int
  action_type      String
  quantity         Int
  zone_name        String?
  return_reason    String?
  cabinet_status   String?
  cancel_reason    String?
  image_url        String?
  created_at       DateTime    @default(now())
  serial_number    String?
  distance_warning String?
  lat              Float?
  lng              Float?
  delivery_by      String?
  to_warehouse_id  Int?
  warehouse_id     Int?
  note             String?
  activity_name    String?
  item             MasterItem? @relation(fields: [item_id], references: [id])
  job              Job?        @relation(fields: [job_id], references: [job_id])
  operator         User        @relation(fields: [operator_id], references: [id])
  target_warehouse Warehouse?  @relation("TargetWarehouse", fields: [to_warehouse_id], references: [id])
  warehouse        Warehouse?  @relation(fields: [warehouse_id], references: [id])
  zone             Zone?       @relation(fields: [zone_name], references: [name])
}

model SystemSetting {
  key   String @id
  value String
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  user_id    Int?
  ip_address String?
  location   String?
  user_agent String?
  action     String?
  created_at DateTime @default(now())
  user       User?    @relation(fields: [user_id], references: [id])
}
